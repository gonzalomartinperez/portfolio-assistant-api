ENVIRONMENT=production
AI_PROVIDER=fixture
EMBEDDINGS_PROVIDER=fixture
ALLOW_PAID_AI=false
DATABASE_URL=postgresql://assistant_app:REPLACE_WITH_PRIVATE_PASSWORD@postgres:5432/assistant
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
ALLOWED_ORIGINS=https://assistant.gonzalomartinperez.com,https://gonzalomartinperez.com
SECURE_COOKIES=true
RATE_HASH_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
# Resolve the sole proxy's actual container IP during provisioning; never use *.
TRUSTED_PROXY_IPS=REPLACE_WITH_EXACT_PROXY_PEER_IP
RUN_TIMEOUT_SECONDS=60
RETENTION_DAYS=7
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
