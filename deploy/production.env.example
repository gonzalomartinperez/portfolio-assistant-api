# Planning template only. Create private files with mode 0600; never commit values.
COMPOSE_PROJECT_NAME=portfolio-assistant
API_IMAGE=ghcr.io/gonzalomartinperez/portfolio-assistant-api@sha256:REPLACE_WITH_TESTED_DIGEST
WEB_IMAGE=ghcr.io/gonzalomartinperez/portfolio-assistant-web@sha256:REPLACE_WITH_FRONTEND_OWNER_DIGEST
# Migration credentials are mounted only for explicit operator commands.
MIGRATION_ENV_FILE=/srv/portfolio-assistant/secrets/migration.env
API_ENV_FILE=/srv/portfolio-assistant/secrets/api.env
POSTGRES_ENV_FILE=/srv/portfolio-assistant/secrets/postgres.env
NEO4J_ENV_FILE=/srv/portfolio-assistant/secrets/neo4j.env
TLS_DIRECTORY=/srv/shared-proxy/tls/assistant.gonzalomartinperez.com
PUBLIC_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
