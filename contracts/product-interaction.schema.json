{
  "additionalProperties": false,
  "properties": {
    "cell_x": {
      "anyOf": [
        {
          "maximum": 7,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cell X"
    },
    "cell_y": {
      "anyOf": [
        {
          "maximum": 7,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cell Y"
    },
    "event_id": {
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_name": {
