        "home-education",
        "home-contact",
        "about-story",
        "about-focus",
        "about-principles",
        "about-opportunities",
        "work-rampy",
        "work-teamcubation",
        "work-cooperativa",
        "work-independent",
        "work-projects",
        "filomena-problem",
        "filomena-approach",
        "filomena-outcomes",
        "filomena-evidence",
        "stack-catalogue",
        "stack-scope",
        "education-degree",
        "education-curriculum",
        "education-credentials",
        "education-evidence",
        "cv-downloads",
        "cv-summary",
        "contact-channels",
        "contact-resume"
