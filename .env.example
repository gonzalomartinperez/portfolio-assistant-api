AI_PROVIDER=fixture
EMBEDDINGS_PROVIDER=fixture
ALLOW_PAID_AI=false
DATABASE_URL=postgresql://assistant:assistant@127.0.0.1:5433/assistant
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_HASH_KEY=replace-with-random-value-before-production

# Safe configuration schema; never add usable production credentials.
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
# Optional bounded official-documentation context; production activation is separate.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_TIMEOUT_SECONDS=12
WEB_SEARCH_USD_PER_CALL=0.01
MONTHLY_BUDGET_USD=10.00
RESERVE_CUTOFF_USD=10.00
RESERVATION_USD=0.05
INPUT_USD_PER_MILLION=0.10
OUTPUT_USD_PER_MILLION=0.50
EMBEDDING_USD_PER_MILLION=0.02
NEO4J_DATABASE=neo4j
KNOWLEDGE_POLL_SECONDS=60
KNOWLEDGE_FRESHNESS_SECONDS=90
REQUIRE_FRESH_KNOWLEDGE=false
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
OTEL_SDK_DISABLED=true

# Optional private operations. Empty values disable this feature.
# Supply a random URL-safe 32–256-character token through runtime secret delivery.
OPS_READ_TOKEN=
# Full source commit of the deployed API image; required with operational access.
OPS_API_COMMIT=
OPS_TRACE_SAMPLE_RATIO=0.1
# Private collector origin; unset by default. Production infrastructure is vps-ops-owned.
OTEL_PRIVATE_ENDPOINT=
