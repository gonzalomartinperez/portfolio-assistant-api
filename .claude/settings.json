{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "Template from engineering-standards v1.0.0 merged with repo rules. .env.* is not denied by glob because permission rules cannot exempt .env.example; guard-files.py enforces the full rule. The sealed holdout (M2) is denied for reads.",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run python -m scripts.:*)",
      "Bash(uv run python -m contracts.export)",
      "Bash(just:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(pkill -f:*)",
      "Bash(rm -rf /:*)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Read(**/.env.local)",
      "Read(./.env.development)",
      "Read(**/.env.development)",
      "Read(./.env.production)",
      "Read(**/.env.production)",
      "Read(./.env.test)",
      "Read(**/.env.test)",
      "Read(./.env.staging)",
      "Read(**/.env.staging)",
      "Read(./evals/full/holdout.sealed.jsonl)",
      "Read(**/holdout.sealed.jsonl)",
      "Bash(cat evals/full/holdout.sealed.jsonl:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.py\""
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.py\""
          }
        ]
      }
    ]
  }
}
